# Environment configuration for document-intelligence-ai.
# Copy to .env and adjust. All variables use the DOCAI_ prefix.

DOCAI_APP_NAME=document-intelligence-ai
DOCAI_ENVIRONMENT=development
DOCAI_LOG_LEVEL=INFO

# OCR settings
DOCAI_OCR_ENGINE=fallback
DOCAI_OCR_LANGUAGE=eng
DOCAI_MAX_FILE_SIZE_MB=25

# Classification & storage
DOCAI_CLASSIFIER_MODEL=heuristic
DOCAI_STORAGE_BACKEND=local
DOCAI_CONFIDENCE_THRESHOLD=0.5
