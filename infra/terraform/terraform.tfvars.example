# Copy to terraform.tfvars and adjust for your environment.
region                   = "us-east-1"
environment              = "dev"
project_name             = "document-intelligence-ai"
container_image          = "document-intelligence-ai:latest"
documents_bucket         = "document-intelligence-ai-documents"
results_table_name       = "document-intelligence-ai-results"
log_retention_days       = 30
enable_bucket_versioning = true
